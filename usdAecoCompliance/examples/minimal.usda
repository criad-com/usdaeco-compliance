#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    fallbackPrimTypes = {
        token[] AecoSite = ["Xform"]
        token[] AecoFacility = ["Xform"]
        token[] AecoLevel = ["Xform"]
        token[] AecoSpecification = ["Scope"]
        token[] AecoRequirement = ["Scope"]
    }
)
def Xform "World" {
    def AecoSite "Site" {
        string aeco:id = "24d8b219-2b8e-5ad9-bcf0-9e715e33f5fd"
        def AecoFacility "Facility" {
            string aeco:id = "b37030c6-46e7-5bf5-a7cb-f0fc4761bd11"
            def AecoLevel "Level" {
                string aeco:id = "4844aa6e-5a98-53da-b92b-ad2b911f794f"
                double aeco:elevation = 0
                def Xform "Reader" (
                    prepend apiSchemas = ["AecoElementAPI", "AecoClassificationAPI:ifc"]
                ) {
                    string aeco:id = "389f690f-80c7-586f-b5b8-c62061af9f71"
                    string aeco:class:ifc:code = "IfcSensor.IDENTIFIERSENSOR"
                    double3 xformOp:translate = (1.3, 0.25, 1.1)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                    def Cube "Body" (prepend apiSchemas = ["AecoDerivedGeometryAPI"]) {
                        string aeco:derived:source = "389f690f-80c7-586f-b5b8-c62061af9f71"
                        token aeco:derived:role = "body"
                        token aeco:derived:approx = "exact"
                        double aeco:derived:tolerance = 0.000001
                        string aeco:derived:stamp = "minimal fixture"
                        double size = 1
                        double3 xformOp:scale = (0.1, 0.06, 0.16)
                        uniform token[] xformOpOrder = ["xformOp:scale"]
                        color3f[] primvars:displayColor = [(0.1, 0.6, 0.4)]
                    }
                }
            }
        }
    }
}
def Scope "Specifications" {
    def AecoSpecification "Reach" {
        string aeco:spec:title = "Illustrative reach"
        string aeco:spec:source = "Illustrative clause 1; demonstration only"
        string[] aeco:spec:appliesToClassification = ["ifc:IfcSensor.IDENTIFIERSENSOR"]
        def AecoRequirement "Height" {
            string aeco:req:measure = "measured:centreHeightAboveFloor"
            token aeco:req:operator = "between"
            double[] aeco:req:values = [0.9, 1.2]
            string aeco:req:unit = "m"
            double aeco:req:tolerance = 0.000001
            token aeco:req:severity = "error"
            string aeco:req:rationale = "Illustrative height band."
        }
    }
}
